page{
  height: 100%;
}
.container{
  display: flex;
  flex-direction: column;
  gap: 50rpx;
background-color: #ffffff;
}
.section1{
  display: flex;
  flex-direction: column;
  text-align: center;
  /*background-color: #d5d5d5;*/
  width: 100%;
  height: 500rpx;
  box-shadow: 0 5rpx 10rpx rgba(0,0,0,0.2);
}
.croix{
  width: 50rpx;
  height: 50rpx;
  margin-left: 90%;
}
.succes{
  width: 70%;
  height: 500rpx;
  margin-left: 15%;
}
.texte{
  font-size: 40rpx;
}
.section2{
 display: flex;
 flex-direction: column;
 gap: 20rpx;
 width: 100%;
 height: 800rpx;
}
.tex{
 font-size: 45rpx;
 margin-left: 40rpx;
}
.content{
 display: flex;
 flex-direction: column;
 gap: 40rpx;
 margin-left: 10rpx;
 margin-right: 11rpx;
}
.habit{
 width: 150rpx;
 height: 150rpx;
}
.detail {
  display: flex;
  flex-direction: column;
  gap: 10px; 
}

.row {
  display: flex;
  justify-content: space-between; 
  align-items: center;
}

.label {
  font-weight: bold;
  color: #333;
}

.value {
  color: #555;
}
.bouton{
  border-radius: 20rpx;
  background-color: #ff7900;
  width: 50%;
  height: 80rpx;
  margin: 100rpx auto 15rpx;
  line-height: 80rpx;
  text-align: center;
  color: #ffffff;
  font-size: 30rpx;
}