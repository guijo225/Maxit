.loader-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 500;
  display: flex;
  justify-content: center;
  align-items: center;
  pointer-events: none; 
  background-color: rgba(0, 0, 0, 0.5);

}

.loader-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 60rpx;
  border-radius: 20rpx;
}

.loader-circle {
  width: 80rpx;
  height: 80rpx;
  border: 8rpx solid #ffe0b2;
  border-top-color: #ff9800;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loader-text {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #ff9800;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
