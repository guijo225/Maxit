}

/* Responsive Design */
@media screen and (max-width: 375px) {
    .carousel-section {
        padding: 15rpx;
    }

    .swiper-container {
        height: 250rpx;
    }

    .condition-card {
        padding: 24rpx;
    }

    .condition-text {
        font-size: 26rpx;
    }

    .footer-fixed {
        padding: 24rpx 15rpx;
        padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    }

    .modal-container {
        width: 95%;
        max-height: 85vh;
        min-height: 300rpx;
    }

   

    .input-field.invitation {
        min-width: 300rpx;
    }
}

.modal-body {
    padding: 40rpx;
    border-radius: 20rpx;
    margin: 20rpx;
}

.section-title {
    margin-bottom: 20rpx;
}

.section-title text {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    padding-bottom: 10rpx;
    display: inline-block;
}

.modalite-text {
    font-size: 28rpx;
    color: #555;
    line-height: 48rpx;
    margin-bottom: 12rpx;
    font-weight: normal;
}

@media screen and (min-width: 414px) {
    .carousel-section {
        padding: 30rpx;
    }

    .swiper-container {
        height: 350rpx;
    }

    .condition-card {
        padding: 40rpx;
    }

    .modal-container {
        width: 90%;
        max-height: 70vh;
        min-height: 250rpx;
    }

}
